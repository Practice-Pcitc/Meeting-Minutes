# OpenAI 服务端密钥。仅放在后端环境中，不要提交真实密钥。
OPENAI_API_KEY=

# 可选，默认使用 gpt-4o-mini-transcribe。
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# 可选。填写 zh 可固定按中文识别；留空允许模型自动识别语言。
OPENAI_TRANSCRIBE_LANGUAGE=

# FunASR OpenAI 兼容转写接口的默认地址。用户可在个人设置中覆盖。
FUNASR_TRANSCRIBE_ENDPOINT=http://127.0.0.1:10095/v1/audio/transcriptions
FUNASR_TRANSCRIBE_MODEL=paraformer-zh
